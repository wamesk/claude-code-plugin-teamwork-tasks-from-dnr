{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Teamwork Tasks Plan",
  "type": "object",
  "required": ["metadata", "tasklists"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "language", "total_md_estimate"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "client": {"type": "string"},
        "project_ref": {"type": "string"},
        "language": {"enum": ["sk", "en", "cs"]},
        "total_md_estimate": {"type": "number", "minimum": 0.0625},
        "source_dnr_path": {"type": "string"},
        "generated_at": {"type": "string"},
        "repo_mode": {"enum": ["backend", "frontend", "standalone"]},
        "repo_name": {"type": "string"},
        "error_http_convention": {"enum": ["ok", "http_status"]},
        "contract_desc_language": {"enum": ["sk", "en", "cs"]},
        "contract_dir": {"type": "string"}
      }
    },
    "tasklists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "tasks"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "section_ref": {"type": "string"},
          "description": {"type": "string"},
          "md_estimate": {"type": "number", "minimum": 0.0625},
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "priority", "estimated_minutes", "goal", "acceptance_criteria", "technical_plan"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "priority": {"enum": ["High", "Medium", "Low"]},
                "estimated_minutes": {"type": "integer", "minimum": 15, "maximum": 480},
                "goal": {"type": "string", "minLength": 1},
                "acceptance_criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                },
                "dependencies": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "assign_to": {
                  "type": "string",
                  "description": "E-mail (or display name) of the Teamwork user this task should be assigned to. Populated in the ASSIGN TO column of the import XLSX."
                },
                "technical_plan": {"type": "string", "minLength": 1},
                "task_kind": {
                  "enum": ["contract", "implementation"],
                  "description": "Marks the 'Definovať API kontrakt' predecessor task ('contract') vs a normal implementation task (default)."
                },
                "role": {
                  "type": "string",
                  "description": "Engineering role the task belongs to (BE, FE, QA, DevOps, …). Drives contract dependency wiring."
                },
                "ui_surface": {
                  "enum": ["new_screen", "existing_screen"],
                  "description": "Set when the task has a user interface: 'new_screen' = adds a screen / admin section / page / module with UI (requires a 'reachability' item in cross_cutting); 'existing_screen' = changes an existing screen. Omit for tasks without UI."
                },
                "cross_cutting": {
                  "type": "array",
                  "description": "Cross-cutting requirements rendered as a sub-block of the acceptance criteria. Keys match teamwork-task-test's review dimensions; its advisory 'framework' dimension is deliberately not allowed here — it belongs in technical_plan only.",
                  "items": {
                    "type": "object",
                    "required": ["dimension", "criterion"],
                    "properties": {
                      "dimension": {"enum": ["ui_ux", "performance", "security", "reachability"]},
                      "criterion": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "contract_ref": {
                  "type": "object",
                  "required": ["feature_slug"],
                  "properties": {
                    "feature_slug": {"type": "string", "minLength": 1},
                    "version": {"type": "string"},
                    "repo": {"type": "string"}
                  },
                  "description": "Links this task to an API contract; triggers the '### Kontrakt' block in the description."
                }
              }
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "description": "API contracts generated from the DNR (backend mode). Empty/absent in frontend and standalone modes.",
      "items": {
        "type": "object",
        "required": ["feature_slug", "openapi"],
        "properties": {
          "feature_slug": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "version": {"type": "string"},
          "linked_sections": {"type": "array", "items": {"type": "string"}},
          "openapi": {
            "type": "object",
            "required": ["endpoints"],
            "properties": {
              "servers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {"type": "string"},
                    "description": {"type": "string"}
                  }
                }
              },
              "endpoints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["method", "path", "operation_id"],
                  "properties": {
                    "method": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "minLength": 1},
                    "operation_id": {"type": "string", "minLength": 1},
                    "summary": {"type": "string"},
                    "description": {"type": "string"},
                    "tags": {"type": "array", "items": {"type": "string"}},
                    "status": {"enum": ["draft", "stable"]},
                    "request_schema": {"type": "string"},
                    "success_data_schema": {"type": "string"},
                    "success_description": {"type": "string"},
                    "error_description": {"type": "string"},
                    "error_statuses": {"type": "array", "items": {"type": "integer"}}
                  }
                }
              },
              "schemas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "description": {"type": "string"},
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name", "type"],
                        "properties": {
                          "name": {"type": "string", "minLength": 1},
                          "type": {"type": "string"},
                          "format": {"type": "string"},
                          "nullable": {"type": "boolean"},
                          "required": {"type": "boolean"},
                          "description": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "data_model": {
            "type": "object",
            "properties": {
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "description": {"type": "string"},
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name"],
                        "properties": {
                          "name": {"type": "string"},
                          "type": {"type": "string"},
                          "nullable": {"type": "boolean"},
                          "description": {"type": "string"}
                        }
                      }
                    },
                    "relations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": {"type": "string"},
                          "target": {"type": "string"},
                          "description": {"type": "string"}
                        }
                      }
                    },
                    "indexes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "columns": {"type": "array", "items": {"type": "string"}},
                          "unique": {"type": "boolean"},
                          "description": {"type": "string"}
                        }
                      }
                    },
                    "notes": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
